{
  "name": "crm-erick",
  "version": "1.0.0",
  "description": "CRM + Lead ops scripts",
  "scripts": {
    "dev": "node scripts/build.js && next dev",
    "build": "node scripts/build.js && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/uazapi-webhook.test.ts tests/followup-operations.test.ts tests/admin-auth.test.ts tests/admin-auth-proxy.test.ts tests/admin-auth-routes.test.ts tests/admin-login-ui.test.ts tests/instagram-prospecting-ui.test.ts tests/prospecting-operations.test.ts tests/prospecting-search.test.ts tests/prospecting-records.test.ts tests/prospecting-actions.test.ts tests/prospecting-api.test.ts tests/prospecting-routes.test.ts tests/serper-client.test.ts tests/pipeline-runtime.test.ts tests/deal-deletion.test.ts tests/dependency-security.test.ts tests/sales-automation.test.ts tests/funnel-metrics.test.ts tests/supabase-pagination.test.ts tests/commercial-automation.test.ts tests/deal-health.test.ts tests/deal-qualification.test.ts tests/deal-forecast.test.ts tests/deal-loss-reasons.test.ts",
    "copy:dry": "node scripts/regenerate-copies.js --dry-run --limit=5",
    "copy:regen": "node scripts/regenerate-copies.js",
    "copy:sync": "node scripts/sync-mock-db-copies.js",
    "copy:all": "npm run copy:regen && npm run copy:sync",
    "leads:search-playbook": "node scripts/lead-search-playbook.js",
    "verify:ostrack-cta": "node scripts/verify-ostrack-cta.js",
    "disparo:audit": "node scripts/audit-disparo-readiness.js",
    "disparo:audit:csv": "node scripts/audit-disparo-readiness.js --csv",
    "db:schema": "echo 'Run scripts/supabase-schema.sql no SQL Editor do Supabase'",
    "db:seed": "node scripts/seed-supabase.js",
    "leads:import": "node js/import-huberick-leads.js",
    "whatsapp:webhook:dry": "node --env-file-if-exists=.env scripts/configure-uazapi-webhook.mjs --dry-run",
    "whatsapp:webhook:configure": "node --env-file-if-exists=.env scripts/configure-uazapi-webhook.mjs",
    "followup:ops": "node --env-file-if-exists=.env scripts/followup-ops.mjs",
    "prospeccao:run": "node --env-file-if-exists=.env scripts/prospeccao-runner.mjs",
    "prospeccao:run:live": "node --env-file-if-exists=.env scripts/prospeccao-runner.mjs --go",
    "prospeccao:prepare": "node scripts/prepare-prospecting-day.mjs",
    "prospeccao:approve": "node scripts/approve-prospecting-day.mjs",
    "prospeccao:dispatch": "node scripts/dispatch-approved-batch.mjs",
    "copy:experiment:report": "node --env-file-if-exists=.env scripts/report-copy-experiment.mjs",
    "automation:commercial": "node --env-file-if-exists=.env scripts/commercial-automation.mjs",
    "health:deals": "node --env-file-if-exists=.env scripts/deal-health.mjs",
    "qualification:deals": "node --env-file-if-exists=.env scripts/deal-qualification.mjs",
    "forecast:deals": "node --env-file-if-exists=.env scripts/deal-forecast.mjs",
    "losses:deals": "node --env-file-if-exists=.env scripts/deal-losses.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}

SUPABASE_URL=https://rezgkabwxxltpprpvdua.supabase.co
SUPABASE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx    # usado apenas server-side pelas rotas /api/deals e /api/contacts
SUPABASE_ACCESS_TOKEN=sbp_xxx          # usado por scripts/apply-schema-api.js
DB_PASSWORD=                            # senha do Postgres (scripts/apply-schema.js)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rezgkabwxxltpprpvdua.supabase.co:5432/postgres

# Instagram / Meta Graph
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_APP_SECRET=

# Serper (somente server-side; aceita varias chaves separadas por virgula)
SERPER_API_KEYS=

# Acesso administrativo (somente server-side)
CRM_ADMIN_EMAIL=
CRM_AUTH_SECRET=                         # gere um segredo aleatorio com pelo menos 32 caracteres

# Threads (reservado)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Facebook Pixel / Meta CAPI
NEXT_PUBLIC_META_PIXEL_ID=1175331711422463
FACEBOOK_PIXEL_ID=1175331711422463
META_DATASET_ID=1175331711422463
META_API_TOKEN=
META_SYSTEM_USER_TOKEN=                 # fallback do META_API_TOKEN
VITE_META_TOKEN=                        # fallback do META_API_TOKEN
FACEBOOK_ACCESS_TOKEN=                  # fallback do META_API_TOKEN
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0

# OStrack
OSTRACK_SALES_URL=https://o-strackpagina.vercel.app/

# Uazapi / WhatsApp (somente server-side)
# Servidor pago dedicado. O antigo free.uazapi.com foi aposentado (caia a cada poucas horas).
UAZAPI_BASE_URL=https://mydrion.uazapi.com
UAZAPI_INSTANCE_TOKEN=
UAZAPI_ADMIN_TOKEN=                       # admin do servidor: cria/lista instancia, nao envia mensagem
UAZAPI_WEBHOOK_URL=https://crmerick.vercel.app/api/webhooks/uazapi
UAZAPI_WEBHOOK_SECRET=                    # opcional; o configurador pode gerar segredo aleatorio

# ---------- Google Analytics (GA4) ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-01ME6SK6JD

# Secret do Measurement Protocol do stream G-01ME6SK6JD (unico da propriedade).
# Enquanto vazio, a perna GA4 server-side fica inerte (a CAPI da Meta segue normal).
GA_MEASUREMENT_PROTOCOL_SECRET=

# ---------- GA4 Data API (aba Google Analytics do Funil + Sinais) ----------
# Property ID numerico (GA4 > Admin > Detalhes da propriedade). NAO e o codigo do fluxo.
GA_PROPERTY_ID=
# Service account com papel Viewer na propriedade (Google Cloud > IAM > contas de servico).
GA_SERVICE_ACCOUNT_EMAIL=
# private_key do JSON do service account, em UMA linha com os 
 escapados.
 escapados.
# ATENCAO: valor ENTRE ASPAS. Sem aspas o parser de .env corta no primeiro espaco
# (o valor vira so "-----BEGIN PRIVATE KEY-----" e o OpenSSL rejeita).
GA_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Hosts incluidos nos relatorios da Mydrion. Outros produtos e previews ficam fora.
GA_HOSTNAMES=www.mydrion.com.br,mydrion.com.br

# ---------- Google Search Console (aba Google do Funil) ----------
# Usa o MESMO service account do GA4 acima, em outro escopo. Alem disso, a conta
# precisa ser adicionada como usuario na propriedade: Search Console >
# Configuracoes > Usuarios e permissoes > Adicionar usuario (leitor basta).
# Sem esse passo a API responde 403 mesmo com a credencial correta.
#
# Formato: "sc-domain:mydrion.com.br" (propriedade de dominio) ou a URL exata com
# barra final ("https://mydrion.com.br/"). Tem que ser IDENTICO ao que aparece no
# seletor de propriedade do Search Console.
GSC_SITE_URL=

# Resend / Mydrion (somente server-side)
RESEND_API_KEY=
MYDRION_EMAIL_FROM=Mydrion <onboarding@resend.dev>

# Ingestao de e-mails -> caixa de entrada do CRM (somente server-side)
# Use um segredo longo e diferente das chaves de API. O mesmo valor autentica
# o webhook Brevo legado e a sincronizacao gratuita Gmail + Apps Script.
BREVO_CONVERSATIONS_WEBHOOK_SECRET=

# Chave da API Brevo. Usada pelos scripts de disparo (scripts/email/) e pela aba
# E-mail dos Funis (/api/email-events), que le entrega, abertura e bounce por
# polling — webhook de evento transacional exigiria plano pago.
# ATENCAO: se a conta tiver "Authorized IPs" ligado, a chave devolve 401 no
# servidor mesmo funcionando na sua maquina. Desligue em
# app.brevo.com/security/authorised_ips.
BREVO_API_KEY=

# ---------- IA (chat de Agentes, /api/ai, CLIs) ----------
# Basta UMA das duas chaves pra IA e o chat de Agentes funcionarem. A cascata tenta
# OpenRouter primeiro e cai pra Groq. Diagnostico: `npm run ai:doctor`.
#
# NAO existe nome de modelo fixo no codigo: src/lib/aiModelCatalog.mjs pergunta ao provedor
# quais modelos gratuitos existem AGORA e escolhe entre eles. Quando um modelo e
# descontinuado, ele some do catalogo sozinho e o proximo assume, sem editar codigo.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Escotilha manual: forca modelos especificos (CSV) em vez da descoberta automatica.
# Use so pra fixar um modelo pontualmente; deixar vazio e o comportamento recomendado.
AI_OPENROUTER_MODELS=
AI_GROQ_MODELS=

# Interruptor de emergencia do chat de Agentes. Vazio ou ausente = LIGADO quando ha chave
# de IA configurada. So o valor literal "false" desliga a aba.
AI_AGENTS_CHAT_ENABLED=

# Teto de tempo da resposta do chat, em ms (padrao 45000, limitado entre 5000 e 55000).
AI_CHAT_TIMEOUT_MS=

# ---------- Vercel (gestao de envs/deploy do projeto crmerick) ----------
# Usado so por scripts locais. NAO precisa existir no ambiente da Vercel.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_2VMByL2PYawwx1zZX17z3BGAlXmK

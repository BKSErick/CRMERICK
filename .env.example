# Instagram / Meta Graph
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_APP_SECRET=

# Serper (somente server-side; aceita varias chaves separadas por virgula)
SERPER_API_KEYS=

# Acesso administrativo (somente server-side)
CRM_ADMIN_EMAIL=
CRM_AUTH_SECRET=                         # gere um segredo aleatorio com pelo menos 32 caracteres

# Threads (reservado)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Facebook Pixel / Meta CAPI
NEXT_PUBLIC_META_PIXEL_ID=1175331711422463
FACEBOOK_PIXEL_ID=1175331711422463
META_DATASET_ID=1175331711422463
META_API_TOKEN=
META_SYSTEM_USER_TOKEN=                 # fallback do META_API_TOKEN
VITE_META_TOKEN=                        # fallback do META_API_TOKEN
FACEBOOK_ACCESS_TOKEN=                  # fallback do META_API_TOKEN
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0

# OStrack
OSTRACK_SALES_URL=https://o-strackpagina.vercel.app/

# Uazapi / WhatsApp (somente server-side)
# Servidor pago dedicado. O antigo free.uazapi.com foi aposentado (caia a cada poucas horas).
UAZAPI_BASE_URL=https://mydrion.uazapi.com
UAZAPI_INSTANCE_TOKEN=
UAZAPI_ADMIN_TOKEN=                       # admin do servidor: cria/lista instancia, nao envia mensagem
UAZAPI_WEBHOOK_URL=https://crmerick.vercel.app/api/webhooks/uazapi
UAZAPI_WEBHOOK_SECRET=                    # opcional; o configurador pode gerar segredo aleatorio

# ---------- Google Analytics (GA4) ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-01ME6SK6JD

# Secret do Measurement Protocol do stream G-01ME6SK6JD (unico da propriedade).
# Enquanto vazio, a perna GA4 server-side fica inerte (a CAPI da Meta segue normal).
GA_MEASUREMENT_PROTOCOL_SECRET=

# ---------- GA4 Data API (aba Google Analytics do Funil + Sinais) ----------
# Property ID numerico (GA4 > Admin > Detalhes da propriedade). NAO e o codigo do fluxo.
GA_PROPERTY_ID=
# Service account com papel Viewer na propriedade (Google Cloud > IAM > contas de servico).
GA_SERVICE_ACCOUNT_EMAIL=
# private_key do JSON do service account, em UMA linha com os 
 escapados.
 escapados.
# ATENCAO: valor ENTRE ASPAS. Sem aspas o parser de .env corta no primeiro espaco
# (o valor vira so "-----BEGIN PRIVATE KEY-----" e o OpenSSL rejeita).
GA_SERVICE_ACCOUNT_PRIVATE_KEY=""
